{
  "name": "the-way-here",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @the-way-here/web build && pnpm --filter @the-way-here/server build",
    "start": "node scripts/start.mjs",
    "typecheck": "pnpm --filter @the-way-here/server typecheck && pnpm --filter @the-way-here/web typecheck && pnpm --filter @the-way-here/desktop typecheck",
    "test": "pnpm --filter @the-way-here/wiki-core test && pnpm --filter @the-way-here/life-views test && pnpm --filter @the-way-here/run-manager test && pnpm --filter @the-way-here/server test && pnpm --filter @the-way-here/web test && pnpm test:desktop",
    "doctor": "node scripts/doctor.mjs",
    "web:verify": "pnpm build && node scripts/verify-web.mjs",
    "desktop": "pnpm build && pnpm desktop:native && pnpm --filter @the-way-here/desktop dev",
    "desktop:package": "pnpm build && node scripts/package-desktop.mjs",
    "desktop:release:prepare": "node scripts/package-direct.mjs --prepare",
    "desktop:release:check": "node scripts/package-direct.mjs",
    "desktop:ship": "pnpm desktop:release && pnpm desktop:publish",
    "desktop:publish": "node scripts/publish-direct.mjs",
    "desktop:release": "node scripts/package-direct.mjs --build",
    "test:desktop": "pnpm --filter @the-way-here/desktop test",
    "desktop:native": "node scripts/build-desktop-native.mjs",
    "desktop:verify": "pnpm web:verify && node scripts/verify-desktop.mjs",
    "appstore:assets": "pnpm build && node scripts/prepare-app-store-assets.mjs",
    "appstore:check": "node scripts/package-mas.mjs",
    "appstore:dev": "node scripts/package-mas.mjs --build",
    "appstore:release": "node scripts/package-mas.mjs --build --release"
  },
  "devDependencies": {
    "@openai/codex": "0.162.1",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "yaml": "^2.8.1"
  }
}
